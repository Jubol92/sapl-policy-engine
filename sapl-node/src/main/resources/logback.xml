<configuration>
    <!-- Loaded by logback directly at JVM startup — before Spring Boot initializes.
         NopStatusListener suppresses the |-INFO / |-WARN internal status output.
         Spring Boot then replaces this with logback-spring.xml for server mode.
         CLI mode: configureCliLogging() calls context.reset() and overrides everything. -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %-40.40logger{39} : %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
